# Copy to .env and change every value before running docker compose.
LEDGER_JWT_SECRET=change-me-to-a-random-string-with-32-chars-or-more
LEDGER_ADMIN_EMAIL=admin@ledger.dev
LEDGER_ADMIN_PASSWORD=change-me-please
# log | kafka | relay
LEDGER_EVENTS_PUBLISHER=kafka
# Only used when LEDGER_EVENTS_PUBLISHER=relay (see webhook-relay)
RELAY_URL=http://host.docker.internal:8000
RELAY_API_KEY=
